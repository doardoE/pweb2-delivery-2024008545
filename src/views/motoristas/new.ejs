<% const editando = Boolean(dados && dados.id); %>
<div class="form-container">
  <h1><%= editando ? 'Editar Motorista' : 'Novo Motorista' %></h1>

  <% if (erros && erros.length > 0) { %>
    <div class="alert alert-error" role="alert">
      <ul>
        <% erros.forEach(erro => { %>
          <li><%= erro %></li>
        <% }); %>
      </ul>
    </div>
  <% } %>

  <form method="POST"
        action="<%= editando ? `/motoristas/${dados.id}?_method=PATCH` : '/motoristas' %>"
        novalidate>
    <% if (editando) { %><input type="hidden" name="_method" value="PATCH"><% } %>

    <div class="form-group <% if (erros && erros.some(e => e.toLowerCase().includes('nome'))) { %>has-error<% } %>">
      <label for="nome">Nome</label>
      <input
        type="text"
        id="nome"
        name="nome"
        value="<%= dados.nome || '' %>"
        placeholder="Nome completo"
        required
      >
    </div>

    <div class="form-group <% if (erros && erros.some(e => e.toLowerCase().includes('cpf'))) { %>has-error<% } %>">
      <label for="cpf">CPF</label>
      <input
        type="text"
        id="cpf"
        name="cpf"
        value="<%= dados.cpf || '' %>"
        placeholder="000.000.000-00"
        autocomplete="off"
        required
      >
    </div>

    <div class="form-group <% if (erros && erros.some(e => e.toLowerCase().includes('placa'))) { %>has-error<% } %>">
      <label for="placaVeiculo">Placa do veículo <span>(opcional)</span></label>
      <input
        type="text"
        id="placaVeiculo"
        name="placaVeiculo"
        value="<%= dados.placaVeiculo || '' %>"
        placeholder="ABC1D23"
      >
    </div>

    <div class="form-actions">
      <a href="/motoristas" class="btn btn-secondary">Cancelar</a>
      <button type="submit" class="btn btn-primary"><%= editando ? 'Salvar Alterações' : 'Criar Motorista' %></button>
    </div>
  </form>
</div>
