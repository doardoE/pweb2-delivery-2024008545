<%- include('../partials/flash') %>
<section class="page-header"><div><h1>Motoristas</h1><p>Equipe cadastrada para realizar as entregas.</p></div><a class="btn btn-primary" href="/motoristas/new">Novo motorista</a></section>
<% if (!motoristas.length) { %>
  <div class="card"><p>Nenhum motorista cadastrado.</p></div>
<% } else { %>
  <div class="table-wrap"><table class="table"><thead><tr><th>Nome</th><th>CPF</th><th>Placa</th><th>Status</th><th></th></tr></thead><tbody>
    <% motoristas.forEach(motorista => { %><tr><td><%= motorista.nome %></td><td><%= motorista.cpf %></td><td><%= motorista.placaVeiculo || '—' %></td><td><%= motorista.status %></td><td><a href="/motoristas/<%= motorista.id %>">Detalhes</a></td></tr><% }) %>
  </tbody></table></div>
<% } %>
